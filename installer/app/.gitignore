# The repo ignores every dist/ directory. The window embeds frontend/dist, so the
# directory (but not the build output) must exist on a fresh checkout for Go to compile.
!/frontend/dist/
/frontend/dist/*
!/frontend/dist/.gitkeep
# Generated by `wails build` / `wails generate module`.
/frontend/wailsjs/
/frontend/node_modules/
/build/bin/
/frontend/package.json.md5
