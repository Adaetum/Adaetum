
# --- Embedded repo copy (installer context) ---
%post --nochroot --interpreter=/bin/bash
set -euo pipefail

stage_log="/tmp/adaetum-post-embed-repo.log"
exec > >(tee -a "${stage_log}") 2>&1
post_stage_exit() {
  local rc="$?"
  if [ "${rc}" -ne 0 ]; then
    echo "[BOOTSTRAP] embedded bootstrap assets stage failed (rc=${rc}); uploading installer diagnostics"
    [ -x /tmp/collect-storage-diag.sh ] && /tmp/collect-storage-diag.sh /tmp || true
  fi
  exit "${rc}"
}
trap post_stage_exit EXIT

target_root="/mnt/sysroot"
detector_source="/run/install/repo/ks/detect-cluster-bootstrap-mode.py"
detector_target="${target_root}/usr/local/libexec/adaetum/detect-cluster-bootstrap-mode.py"
gum_source="/run/install/repo/ks/gum.rpm"
gum_target="${target_root}/usr/bin/gum"

# Automatic start/join selection runs before the remotely fetched Ansible
# bundle. Install only its focused decision helper from the trusted media;
# the repository and operational payload still come from Worker/R2.
if [ ! -f "${detector_source}" ]; then
  echo "[BOOTSTRAP] Missing bootstrap mode detector on installer media" \
    >>"${target_root}/root/bootstrap-post.log"
  exit 1
fi
install -D -m 0755 "${detector_source}" "${detector_target}"

# The ISO builder verifies the release checksum before writing this binary to
# media. Every installed server gets its own token and service on first boot.
agent_source="/run/install/repo/ks/adaetum-agent"
if [ ! -f "${agent_source}" ]; then
  echo "[BOOTSTRAP] Missing host agent on installer media" >>"${target_root}/root/bootstrap-post.log"
  exit 1
fi
install -D -m 0755 "${agent_source}" "${target_root}/usr/local/bin/adaetum-agent"
# Only development media (task init:dev) carries this file. It adds arguments to the
# agent's command line, so it must never exist on a production ISO, whose pinned agent
# may not know them.
if [ -f /run/install/repo/ks/adaetum-agent.env ]; then
  install -D -m 0644 /run/install/repo/ks/adaetum-agent.env "${target_root}/etc/adaetum/agent.env"
fi
# The account sign-in service (adaetum/auth) is optional: media that does not carry it
# leaves a host accepting only its access token. First boot installs its unit only when
# the binary is here (75-firstboot-install-handoff.ksfrag).
if [ -f /run/install/repo/ks/adaetum-auth ]; then
  install -D -m 0755 /run/install/repo/ks/adaetum-auth "${target_root}/usr/local/bin/adaetum-auth"
fi

if [ ! -f "${gum_source}" ]; then
  echo "[BOOTSTRAP] Missing required Gum RPM on installer media" \
    >>"${target_root}/root/bootstrap-post.log"
  exit 1
fi
if ! rpm --root "${target_root}" -Uvh --replacepkgs "${gum_source}" >>"${target_root}/root/bootstrap-post.log" 2>&1; then
  echo "[BOOTSTRAP] Failed to install required Gum RPM from installer media" \
    >>"${target_root}/root/bootstrap-post.log"
  exit 1
fi
if [ ! -x "${gum_target}" ]; then
  echo "[BOOTSTRAP] Gum RPM completed without /usr/bin/gum" \
    >>"${target_root}/root/bootstrap-post.log"
  exit 1
fi

printf "%s\n" "[BOOTSTRAP] Installed required Gum console dependency from installer media; first boot must fetch bootstrap artifacts from the Worker/R2 path" \
  >>"${target_root}/root/bootstrap-post.log"
%end
