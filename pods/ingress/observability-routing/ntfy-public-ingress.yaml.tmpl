apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ntfy-api-public
  namespace: observability
  annotations:
    # Native ntfy clients require API responses, not an Authentik browser
    # redirect. The workload enforces deny-all native authentication instead.
    external-dns.alpha.kubernetes.io/hostname: ntfy.example.services
    # A topic deep link subscribes each authenticated web client locally while
    # leaving native publish and subscribe API paths unchanged.
    nginx.ingress.kubernetes.io/app-root: /adaetum-alerts
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
spec:
  ingressClassName: nginx
  rules:
    - host: ntfy.example.services
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ntfy
                port:
                  number: 80
